[Unit]
Description=AEAA FastAPI Backend
After=syslog.target network.target

[Service]
User=root
WorkingDirectory=/root/aeaa-BE
ExecStart=/usr/bin/python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8018
SuccessExitStatus=143
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
